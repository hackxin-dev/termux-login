            print("[*] Access Granted")
            time.sleep(2)
            os.system("clear")
            break
          else:
            print(f"[!] Access Denied, Wrong Password, remaining {attempt} attempts")
            time.sleep(2)
            os.system("clear")
        except KeyboardInterrupt:
          print()
          print("[!] Access Denied")
          os.system(f"kill -9 {PID}")
        except EOFError:
          print()
          print("[!] Access Denied")
          os.system(f"kill -9 {PID}")
  else:
    os.system("clear")
