    with open(f"{home}/.shell-lock/.user", "w") as fu:
      fu.write(sha256(str(f"{newUsername}:{newPassword}").encode()).hexdigest())
      fu.close()
      print()
      print("[*] Successful registration.")
      time.sleep(2)
      os.system("clear")
      
if __name__ == "__main__":
